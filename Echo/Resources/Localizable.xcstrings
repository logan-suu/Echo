    "Tap a geofence to view details. Geofences are automatically created from your visit patterns. Push deduplication: a geofence only delivers once per entry; must exit and re-enter to deliver again.": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a geofence to view details. Geofences are automatically created from your visit patterns. Push deduplication: a geofence only delivers once per entry; must exit and re-enter to deliver again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击地理围栏查看详情。地理围栏根据你的访问模式自动创建。推送去重：每个围栏每次进入只投递一次；需离开后再次进入才会再次投递。"
          }
        }
      }
    },
