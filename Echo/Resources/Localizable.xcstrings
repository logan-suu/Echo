    "Deleting Echo data will erase all indices, vectors, settings and feedback. Your original photos, videos, and files in system apps will NOT be affected. A 24-hour cooling period applies before data is permanently removed.": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting Echo data will erase all indices, vectors, settings and feedback. Your original photos, videos, and files in system apps will NOT be affected. A 24-hour cooling period applies before data is permanently removed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 Echo 数据将清除所有索引、向量、设置和反馈。你在系统应用中的原始照片、视频和文件不受影响。数据永久删除前有 24 小时冷却期。"
          }
        }
      }
    },
    "Echo · 回响 — Your memories, always within reach. All AI processing runs locally on your device. No data ever leaves your phone.": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Echo · 回响 — Your memories, always within reach. All AI processing runs locally on your device. No data ever leaves your phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Echo · 回响 — 你的记忆，永远触手可及。所有 AI 处理均在设备本地完成，没有任何数据离开你的手机。"
          }
        }
      }
    },
    "Geofence push resets on exit+re-enter. Anniversary check runs daily at 9:00 AM. Emotion analysis caches results for 24 hours and uses 30-second debounce for new queries/feelings. Auditing records all awakening activity for 30 days (viewable in Audit Log).": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Geofence push resets on exit+re-enter. Anniversary check runs daily at 9:00 AM. Emotion analysis caches results for 24 hours and uses 30-second debounce for new queries/feelings. Auditing records all awakening activity for 30 days (viewable in Audit Log)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地理围栏推送在退出+重新进入时重置。纪念日检查每天上午 9:00 运行。情绪分析缓存结果 24 小时，并对新查询/感受使用 30 秒防抖。审计记录所有唤醒活动 30 天（可在审计日志中查看）。"
          }
        }
      }
    },
