{
  "$schema": "https://echo-ui-automation/schemas/contracts/state/v1",
  "version": "1.0.0",
  "surfaceId": "degradation-banner",
  "stateId": "l2Recoverable",
  "dataConditions": { "errorLevel": "L2", "retryPolicy": "manual" },
  "allowedActions": ["banner.retryPendingOperation", "banner.dismiss"],
  "properties": {
    "isBannerVisible": true,
    "bannerIcon": "exclamationmark.circle",
    "bannerMessage": "This action could not be completed. You can retry it when ready.",
    "showBackgroundTaskToggle": false,
    "backgroundTasksPaused": false,
    "showRetryButton": true,
    "showPendingOpsEntry": true,
    "bannerTint": "yellow"
  }
}
