{
  "$schema": "https://echo-ui-automation/schemas/contracts/state/v1",
  "version": "1.0.0",
  "surfaceId": "degradation-banner",
  "stateId": "modelDegraded",
  "dataConditions": { "runtimeCondition": "modelDegraded", "isBannerVisible": true },
  "allowedActions": ["banner.retryModelLoad", "banner.openSettings", "banner.dismiss"],
  "properties": {
    "isBannerVisible": true,
    "bannerIcon": "exclamationmark.triangle",
    "bannerMessage": "Functional limitations due to model loading issues.",
    "showBackgroundTaskToggle": false,
    "backgroundTasksPaused": false,
    "showRetryButton": true,
    "showSettingsButton": true,
    "bannerTint": "red"
  }
}
