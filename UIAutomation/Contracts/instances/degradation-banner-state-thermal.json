{
  "$schema": "https://echo-ui-automation/schemas/contracts/state/v1",
  "version": "1.0.0",
  "surfaceId": "degradation-banner",
  "stateId": "thermal",
  "dataConditions": { "runtimeCondition": "thermal", "isBannerVisible": true },
  "allowedActions": ["banner.dismiss"],
  "properties": {
    "isBannerVisible": true,
    "bannerIcon": "thermometer.high",
    "bannerMessage": "Device temperature is high. Some features have been temporarily simplified.",
    "showBackgroundTaskToggle": false,
    "backgroundTasksPaused": false,
    "showRetryButton": false,
    "bannerTint": "orange"
  }
}
