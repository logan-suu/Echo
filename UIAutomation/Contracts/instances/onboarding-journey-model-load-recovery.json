  "preconditionFixtures": ["onboarding-model-load-error"],
  "assertions": [
    { "after": "onboarding.retryModelLoad", "observable": "Manual retry reloads only local bundle artifacts; no timer-driven auto-retry (US-RES-004 AC-3)" },
