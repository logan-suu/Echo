{
  "$schema": "https://echo-ui-automation/schemas/contracts/state/v1",
  "stateId": "cached",
  "surfaceId": "translation",
  "dataConditions": {
    "memory": "Text memory (zh-Hans), preferredLanguage = en-US",
    "translationVisible": true,
    "cacheHit": true,
    "cacheEntryAgeDays": "< 7",
    "translatedText": "English translation served from TranslationCache"
  },
