{
  "$schema": "https://echo-ui-automation/schemas/contracts/state/v1",
  "version": "1.0.0",
  "surfaceId": "degradation-banner",
  "stateId": "lowPower",
  "dataConditions": { "runtimeCondition": "lowPower", "isBannerVisible": true },
  "allowedActions": ["banner.toggleBackgroundTasks", "banner.dismiss"],
  "properties": {
    "isBannerVisible": true,
    "bannerIcon": "battery.25",
    "bannerMessage": "Low Power Mode is enabled. Memory search precision may be reduced.",
    "showBackgroundTaskToggle": true,
    "backgroundTasksPaused": true,
    "showRetryButton": false,
    "bannerTint": "yellow"
  }
}
