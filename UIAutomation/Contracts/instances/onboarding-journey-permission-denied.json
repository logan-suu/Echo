{
  "$schema": "https://echo-ui-automation/schemas/contracts/journey/v1",
  "journeyId": "onboarding-permission-denied",
  "steps": [
    { "surfaceId": "onboarding", "stateId": "welcome", "actionId": "onboarding.start" },
    { "surfaceId": "onboarding", "stateId": "privacyConsent", "actionId": "onboarding.privacyAgree" },
    { "surfaceId": "onboarding", "stateId": "permissions", "actionId": "onboarding.permissionDeny" },
    { "surfaceId": "onboarding", "stateId": "permissionDenied", "actionId": "onboarding.openSettings" }
  ],
  "preconditionFixtures": ["onboarding-welcome"],
  "assertions": [
    { "after": "onboarding.permissionDeny", "observable": "Photo permissionDenied state with Open Settings button; no notification, location or HealthKit prompt" },
    { "after": "onboarding.openSettings", "observable": "openSettingsURLString intent fired (UIApplication.openSettingsURLString)" },
    { "alternative": "onboarding.permissionSkip", "observable": "Continues to language without PhotoKit and without any other permission request" }
  ],
  "version": "1.1.0"
}
