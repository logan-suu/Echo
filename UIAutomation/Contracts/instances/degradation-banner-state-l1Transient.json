{
  "$schema": "https://echo-ui-automation/schemas/contracts/state/v1",
  "version": "1.0.0",
  "surfaceId": "degradation-banner",
  "stateId": "l1Transient",
  "dataConditions": { "errorLevel": "L1", "retryPolicy": "automatic" },
  "allowedActions": ["banner.retryL1"],
  "properties": {
    "isBannerVisible": true,
    "bannerIcon": "arrow.clockwise",
    "bannerMessage": "Something went wrong briefly. Echo is retrying automatically.",
    "showBackgroundTaskToggle": false,
    "backgroundTasksPaused": false,
    "showRetryButton": false,
    "showToast": true,
    "bannerTint": "blue"
  }
}
