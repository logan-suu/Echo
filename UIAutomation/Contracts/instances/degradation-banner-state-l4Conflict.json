{
  "$schema": "https://echo-ui-automation/schemas/contracts/state/v1",
  "version": "1.0.0",
  "surfaceId": "degradation-banner",
  "stateId": "l4Conflict",
  "dataConditions": { "errorLevel": "L4", "conflict": true },
  "allowedActions": ["banner.resolveConflict"],
  "properties": {
    "isBannerVisible": true,
    "bannerIcon": "arrow.triangle.2.circlepath",
    "bannerMessage": "Two versions of this memory conflict. Choose which one to keep.",
    "showBackgroundTaskToggle": false,
    "backgroundTasksPaused": false,
    "showResolveConflict": true,
    "bannerTint": "orange"
  }
}
