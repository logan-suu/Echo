{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo-ui-automation/schemas/contracts/journey/v1",
  "title": "Journey Contract",
  "description": "A cross-surface behavioral path",
  "type": "object",
  "required": ["journeyId", "steps", "preconditionFixtures"],
  "properties": {
    "journeyId": { "type": "string", "description": "Stable identifier" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["surfaceId", "stateId", "actionId"],
        "properties": {
          "surfaceId": { "type": "string" },
          "stateId": { "type": "string" },
          "actionId": { "type": ["string", "null"], "description": "Action that advances this step; null marks a terminal observation-only step" }
        }
      }
    },
    "preconditionFixtures": { "type": "array", "items": { "type": "string" }, "description": "Fixture IDs required before journey starts" },
    "assertions": { "type": "array", "items": { "type": "object" }, "description": "Observable assertions, never Core internals" },
    "version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$", "description": "Schema-major-compatible contract version" }
  }
}
