{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo-ui-automation/schemas/contracts/design-profile/v1",
  "title": "Design Profile Contract",
  "description": "Global visual and interaction identity shared by every Echo surface",
  "type": "object",
  "required": [
    "profileId",
    "version",
    "baseProfile",
    "approvalRecord",
    "globalVisualLanguage",
    "surfaceFamilyRules",
    "coveredDomains"
  ],
  "properties": {
    "profileId": { "type": "string", "const": "echo-memory-canvas" },
    "version": { "type": "string", "const": "1.1.0" },
    "baseProfile": { "type": "string", "const": "apple-native" },
    "approvalRecord": { "type": "object" },
    "globalVisualLanguage": { "type": "object" },
    "surfaceFamilyRules": { "type": "object" },
    "coveredDomains": { "type": "array", "minItems": 12, "uniqueItems": true, "items": { "type": "string" } },
    "prohibited": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
