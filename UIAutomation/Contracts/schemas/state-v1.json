{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo-ui-automation/schemas/contracts/state/v1",
  "title": "State Contract",
  "description": "A deterministic UI state of a Surface",
  "type": "object",
  "required": ["stateId", "surfaceId", "dataConditions", "allowedActions"],
  "properties": {
    "stateId": { "type": "string", "description": "Stable identifier (e.g., 'loaded', 'empty', 'loading', 'error', 'permission-denied')" },
    "surfaceId": { "type": "string", "description": "Foreign key → surface.surfaceId" },
    "dataConditions": { "type": "object", "description": "Fixture conditions that produce this state" },
    "allowedActions": { "type": "array", "items": { "type": "string" }, "description": "actionId values valid in this state" },
    "expectedSemantics": { "type": "object", "description": "Expected accessibility labels, traits, reading order" },
    "version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$", "description": "Schema-major-compatible contract version" }
  }
}
